# Normalisiert Line-Endings unabhaengig vom lokalen core.autocrlf-Setting:
# alle Text-Files landen mit LF im Index und im Working-Tree. PowerShell-
# Skripte bleiben CRLF, weil Windows-Hosts sie nativ ausführen.

* text=auto eol=lf

# Quellcode und Konfiguration
*.php       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.twig      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.neon      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# Windows-Skripte
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binaerdateien — kein Whitespace-Diff, kein EOL-Mangling
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.gz        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
