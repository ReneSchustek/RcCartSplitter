parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        # `EntitySearchResult` bleibt in 6.8 bestehen, sie **erbt nur nicht mehr** von
        # `EntityCollection`. Wer die Entitäten über `getEntities()` holt — und das tut dieses
        # Plugin überall —, merkt davon nichts. Es gibt hier nichts zu migrieren; die Meldungen
        # sind Vorankündigungen von Shopware, keine Befunde am eigenen Code, und fallen mit der
        # Anhebung auf 6.8 als Mindestfassung von selbst weg. Einzeln aufgeführt statt als
        # erzeugte Baseline, damit auffällt, wenn die Liste wächst.
        #
        # Betroffen wären nur Sammlungs-Methoden direkt am Suchergebnis (`first()`, `filter()`, …).
        # Die gibt es hier nicht — geprüft beim Umstieg auf die Schreibweise von Shopware 6.8.
        -
            message: '#(Call to method \w+\(\) of deprecated class|Instantiation of deprecated class|Access to constant on deprecated class|Return type of (anonymous function|method) [^ ]* ?has typehint with deprecated class) Shopware\\Core\\Framework\\DataAbstractionLayer\\Search\\EntitySearchResult#'

        # In Tests gibt es keinen Aufrufer, aus dem sich ein Kontext ableiten ließe. Ein aufgebauter
        # Nutzerkontext täuschte eine Abhängigkeit vor, die der Test gar nicht hat.
        -
            message: '#Do not use Shopware\\Core\\Framework\\Context::createDefaultContext#'
            path: tests/*

    banned_code:
        nodes:
            - { type: Stmt_Echo, functions: null }
            - { type: Expr_Eval, functions: null }
            - { type: Expr_Exit, functions: null }
            - { type: Expr_Print, functions: null }
            - { type: Expr_ShellExec, functions: null }
            -
                type: Expr_FuncCall
                functions:
                    - dd
                    - debug_backtrace
                    - dump
                    - exec
                    - passthru
                    - phpinfo
                    - print_r
                    - proc_open
                    - shell_exec
                    - system
                    - var_dump
                    # Zusätzlich gesperrt:
                    - error_log    # Nutze PSR-3 Logger
                    - extract      # Unkontrollierte Variablen
                    - md5          # Nicht kryptographisch — password_hash()
                    - mt_rand      # Nicht kryptographisch — random_int()
                    - rand         # Nicht kryptographisch — random_int()
                    - sha1         # Nicht kryptographisch — password_hash()
                    - unserialize  # Object-Injection — json_decode()
        # use_from_tests aus: Test-Code darf gezielt Test-Klassen nutzen
        use_from_tests: false
        # ignoreErrors muss möglich bleiben für dokumentierte Ausnahmen
        non_ignorable: false

includes:
    - vendor/shopwarelabs/phpstan-shopware/rules.neon
    - vendor/ekino/phpstan-banned-code/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
