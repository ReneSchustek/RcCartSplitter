{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{#
  Ersetzt den Inhalt des TMMS-Hinweistexts unter den Eingabefeldern. Der Text kommt aus der
  Page-Extension `rcCartSplitterTmmsInfo` (Produkt -> Kategorie -> Plugin-Konfiguration), sonst
  aus dem Plugin-Snippet. Container, Sichtbarkeit und Icon bleiben bei TMMS.

  Den Block definiert TMMS selbst. Dass diese Fassung gewinnt, liegt an der Template-Priorität
  1000 in RcCartSplitter.php.
#}
{% block buy_widget_configurator_include_customerinput_informationmessage_content %}
    {% set rcCartSplitterTmmsInfo = page.extensions.rcCartSplitterTmmsInfo ?? null %}
    {% set rcCartSplitterTmmsMessage = rcCartSplitterTmmsInfo
        ? rcCartSplitterTmmsInfo.message
        : null %}
    {% set rcCartSplitterTmmsMessage = rcCartSplitterTmmsMessage
        ?: ('rc-cart-splitter.tmmsInformationMessage'|trans) %}

    {# nl2br maskiert vorher: HTML im Text erscheint als Text, nur Zeilenumbrüche werden zu <br>. #}
    <div class="alert-content-container">
        {{ rcCartSplitterTmmsMessage|nl2br }}
    </div>
{% endblock %}
